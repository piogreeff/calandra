{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calandra",
  "version": "0.0.0",
  "identifier": "dev.calandra.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @calandra/web dev -- --hostname 127.0.0.1 --port 3010",
    "devUrl": "http://127.0.0.1:3010",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @calandra/web run build:static",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Calandra",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility"
  }
}
