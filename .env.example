# Calandra environment — copy to .env and fill in.
# Never commit a real .env. Every key below is documented; no secrets here.

# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=https://calandra.pages.dev
API_URL=https://calandra-api.piogreeff.workers.dev
# Local MCP stdio server target. Defaults to the temporary hosted API if unset.
CALANDRA_API_BASE_URL=https://calandra-api.piogreeff.workers.dev
# Which game-data dataset to load (published per league/patch).
DATASET_VERSION=latest
# R2 object prefix for published artifacts. API reads `${DATASET_R2_PREFIX}/{league}/{patch}.json`.
DATASET_R2_PREFIX=datasets
# R2 object prefix for account snapshots persisted by the API.
SNAPSHOT_R2_PREFIX=snapshots
# Optional dev/self-host Worker binding for a published artifact JSON payload.
# Production should load the published artifact from R2 instead of embedding large JSON in env.
DATASET_ARTIFACT_JSON=

# ── AI (OpenAI via Cloudflare AI Gateway) ──────────────────────────────
OPENAI_API_KEY=
# AI Gateway endpoint — used for caching + cost control.
AI_GATEWAY_URL=
# Hard budget guard for advisory sessions (USD).
AI_SESSION_BUDGET_USD=1.00

# ── GGG official API (OAuth) ───────────────────────────────────────────
# Register an application with Grinding Gear Games to obtain these.
GGG_OAUTH_CLIENT_ID=
GGG_OAUTH_CLIENT_SECRET=
GGG_OAUTH_REDIRECT_URI=https://calandra.pages.dev/auth/ggg/callback
# REQUIRED by GGG: descriptive UA with a contact address.
GGG_USER_AGENT=calandra/0.1 (+https://calandra.pages.dev; contact@example.com)

# ── Cloudflare ─────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Binding names (set in wrangler config; listed here for reference).
KV_ECONOMY=ECONOMY
R2_BUCKET=calandra-data
VECTORIZE_INDEX=calandra-knowledge

# ── Database (Neon Postgres) — optional, for personal snapshots ────────
DATABASE_URL=

# ── Auth (Better Auth) ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://calandra.pages.dev
